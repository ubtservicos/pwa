# Frontend build-time variables (Vercel). Never put an Access Token here.
VITE_APP_URL=https://app.example.com
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_anon_key
VITE_MP_ENVIRONMENT=production
VITE_MP_PUBLIC_KEY=APP_USR-your_live_public_key
VITE_WHATSAPP_AGENT_URL=https://your-production-agent.example/functions/v1/whatsapp-agent

# Sandbox-only payer identity. Leave unset in Production.
VITE_MP_TEST_PAYER_EMAIL=
VITE_MP_TEST_PAYER_CPF=
