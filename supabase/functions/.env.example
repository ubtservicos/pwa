# Environment secrets for Supabase Edge Functions
# DO NOT COMMIT THIS FILE — it is already listed in .gitignore
#
# Instructions:
# 1. Duplicate this file as .env (not tracked by git)
# 2. Fill in the values for your local/sandbox environment
# 3. For production, use `npx supabase secrets set` instead

# Supabase (auto-provided in production, required locally for `supabase functions serve`)
SUPABASE_URL=https://xqujubbqcfqxkfczbidq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Mercado Pago - Sandbox credentials
# Obtenha no painel: https://www.mercadopago.com.br/developers/panel
MP_ACCESS_TOKEN=TEST-your_sandbox_access_token_here
MP_PUBLIC_KEY=TEST-your_sandbox_public_key_here
MP_WEBHOOK_SECRET=your_webhook_hmac_secret_here

# Application Settings
APP_ENV=sandbox
