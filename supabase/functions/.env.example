# Environment secrets for Supabase Edge Functions
# DO NOT COMMIT THIS FILE — it is already listed in .gitignore
#
# Instructions:
# 1. Duplicate this file as .env (not tracked by git)
# 2. Fill in the values for your local/sandbox environment
# 3. For production, use `npx supabase secrets set` instead

# Supabase (auto-provided in production, required locally for `supabase functions serve`)
SUPABASE_URL=https://xqujubbqcfqxkfczbidq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Mercado Pago - explicit sandbox configuration
# Test credentials may also use APP_USR; never infer the environment from the prefix.
MP_ENVIRONMENT=sandbox
MP_ACCESS_TOKEN_SANDBOX=APP_USR-your_sandbox_access_token_here
MP_TEST_PAYER_EMAIL=buyer-generated-by-mp@testuser.com
# Comma-separated Marketplace/Seller test e-mails; prevents a configured self-payment.
MP_TEST_SELLER_EMAILS=marketplace@testuser.com,seller@testuser.com
# Comma-separated Mercado Pago user IDs allowed to authorize Seller OAuth in Sandbox.
MP_TEST_SELLER_USER_IDS=1234567890
MERCADOPAGO_CLIENT_ID=your_marketplace_app_id
MERCADOPAGO_CLIENT_SECRET=your_marketplace_client_secret
MP_REDIRECT_URIS=http://localhost:8080/app/config/financeiro,https://app.example.com/app/config/financeiro
# Generate with: openssl rand -base64 32
MP_TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_key
ALLOWED_ORIGINS=http://localhost:8080,https://app.example.com
MP_WEBHOOK_SECRET=your_webhook_hmac_secret_here

# Application Settings
APP_ENV=sandbox
